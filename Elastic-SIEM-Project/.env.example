# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is safe to commit (placeholders only).

# --- Elasticsearch ---
ELASTIC_PASSWORD=change-me-strong-password
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Kibana ---
KIBANA_SYSTEM_PASSWORD=change-me-strong-password
# Generate with: openssl rand -base64 32
KIBANA_ENCRYPTION_KEY=change-me-32-byte-base64-key
KIBANA_SAVEDOBJECTS_KEY=change-me-32-byte-base64-key

# --- Stack ---
STACK_VERSION=8.12.2
CLUSTER_NAME=elastic-siem-cluster
MEM_LIMIT=1073741824  # 1GB in bytes

# --- IA agents / scripts ---
ES_HOST=http://localhost:9200
GEMINI_API_KEY=your-gemini-api-key-here
ANALYST_NAME=analista-soc
